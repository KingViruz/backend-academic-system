# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Base de datos MySQL (crea la base y las tablas con el script SQL en DBeaver)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=academic_system
# Solo para desarrollo: si es true, TypeORM crea/ajusta las tablas solo. Déjalo en false cuando uses el SQL.
DB_SYNC=false

# Seguridad
JWT_SECRET=cambia-esta-clave-larga-y-secreta
JWT_EXPIRES=8h
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# Reglas académicas
ASISTENCIA_TOLERANCIA_MIN=15
ASISTENCIA_CORRECCION_HORAS=48
# Si es true, el docente solo puede abrir asistencia dentro de la franja de su horario
ASISTENCIA_VALIDAR_FRANJA=false
SENSOR_SIN_SENAL_MIN=10
ALERTA_UMBRAL_INASISTENCIA=20
ALERTA_NOTA_MINIMA=3.0
